# Supabase Authentication & Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API-Football (API-Sports) - SOLO del lado del servidor
# Se usa en las funciones serverless de Vercel (/api/sports/*) para que la
# key nunca se exponga en el navegador.
# Configurar en: Vercel > Project Settings > Environment Variables
SPORTS_API_KEY=your-api-football-key-here

# Usuario de prueba para npm run check:supabase (opcional)
# CHECK_EMAIL=test@example.com
# CHECK_PASSWORD=testing123

# Proveedor primario de resultados en vivo (/api/results): espn | sofascore
# Fallback automático entre ambos y luego API-Football. Default: espn
RESULTS_PROVIDER=espn
