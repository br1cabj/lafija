# Supabase Authentication & Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API-Football / Sports Data API Key (Optional)
# ⚠️ ATENCIÓN: las variables VITE_* se exponen en el bundle del cliente.
# La anon key de Supabase es pública por diseño (la seguridad la dan las RLS,
# ver supabase/schema.sql), pero la API key de API-Football DEBE proxearse
# através de un backend/serverless antes de pasar a producción.
VITE_SPORTS_API_KEY=your-api-football-key-here
